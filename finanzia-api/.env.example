# FinanZIA API — Plantilla de Variables de Entorno
# Copia este archivo a .env y asigna valores para tu entorno local

# Configuración del Servidor
PORT=3001
NODE_ENV=development
APP_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3000

# Base de Datos PostgreSQL Local (Docker Compose)
DATABASE_URL="postgresql://finanzia_user:finanzia_password@localhost:5432/finanzia_db?schema=public"

# Base de Datos de Tests Aislada
DATABASE_TEST_URL="postgresql://finanzia_user:finanzia_password@localhost:5432/finanzia_test?schema=public"

# Autenticación JWT
JWT_SECRET="genera-una-clave-secreta-aleatoria-de-minimo-32-caracteres"
JWT_EXPIRES_IN="7d"

# Google Gemini API (Exclusivo en backend)
GEMINI_API_KEY="tu-api-key-de-google-gemini-aqui"
GEMINI_MODEL="gemini-1.5-flash"

# Throttling / Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100
